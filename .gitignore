# Grav-Kern und Laufzeitdaten der lokalen Entwicklung (scripts/dev-server.sh)
/.grav/

# Laufzeitdaten – gehören nach $GRAV_DATA_DIR, nie ins Repository
/user/accounts/
/user/pages/
/user/data/
/user/media/

# Von Grav erzeugt (Image: beim Build)
/user/config/versions.yaml
/user/config/security-private.php
/user/config/plugins/api-private.php

# Geheimnisse
.env
.env.*
!.env.example
/k8s/**/secret.yaml
/k8s/**/*.secret.yaml

# Tests und Werkzeuge
/tests/tmp/
/tests/screenshots/
node_modules/

# System und Editoren
.DS_Store
Icon
*.sublime-workspace
/.vscode
/.idea
