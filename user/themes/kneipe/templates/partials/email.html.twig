{# E-Mail-Adresse aus den Stammdaten als Link oder markierter Platzhalter #}
{% set email = kneipe.setting('email') %}
{% if email %}{% if icon_before ?? false %}{{ icon('mail') }}{% endif %}<a href="mailto:{{ email }}">{{ email }}</a>{% else %}<mark class="placeholder">[E-Mail-Adresse]</mark>{% endif %}
