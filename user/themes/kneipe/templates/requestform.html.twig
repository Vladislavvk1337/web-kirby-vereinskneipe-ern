{#
  Formular „Freien Termin anfragen“ – funktioniert ohne JavaScript.
  Fehler stehen oben als Übersicht und direkt am jeweiligen Feld.
  Daten: kneipe_form (Plugin) mit slots, values, errors, notice, csrf, timer.
#}
{% extends 'partials/base.html.twig' %}
{% set styles = ['form'] %}

{% block content %}
{% set form = kneipe_form %}
{% set values = form.values %}
{% set errors = form.errors %}
{% set slots = form.slots %}
{% set labels = {
  slot: 'Gewünschter Termin', wishdate: 'Eigenes Wunschdatum', altdate: 'Alternativer Termin',
  groupname: 'Name der Gruppe', grouptype: 'Art der Gruppe', contactname: 'Name der Kontaktperson',
  email: 'E-Mail-Adresse', phone: 'Telefonnummer', intro: 'Kurze Vorstellung', message: 'Nachricht', privacy: 'Datenschutz'
} %}
{% set group_types = {verein: 'Verein', unternehmen: 'Unternehmen', initiative: 'Initiative', privat: 'Private Gruppe'} %}
{% set selected = values.slot ?? '' %}
{% set base = {values: values, errors: errors} %}
{% include 'partials/page-head.html.twig' with {title: page.title, intro: page.header.intro} %}
<div class="container container--narrow section">
  {% if form.notice %}
  <div class="notice notice--danger" role="alert" id="formular-hinweis" tabindex="-1">{{ icon('alert') }}<p>{{ form.notice }}</p></div>
  {% endif %}

  {% if errors|length %}
  <div class="error-summary" role="alert" id="fehleruebersicht" tabindex="-1" aria-labelledby="fehleruebersicht-titel">
    <h2 id="fehleruebersicht-titel">Bitte prüft noch {{ errors|length == 1 ? 'eine Angabe' : errors|length ~ ' Angaben' }}:</h2>
    <ul>
      {% for name, message in errors %}
      <li><a href="#feld-{{ name == 'slot' ? 'slot-' ~ (slots|length ? slots|keys|first : 'anderer') : name }}">{{ labels[name] ?? name }}: {{ message }}</a></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  <form class="form" method="post" action="{{ page.url }}" novalidate>
    <input type="hidden" name="csrf" value="{{ form.csrf }}">
    <input type="hidden" name="formstart" value="{{ form.timer }}">
    <div class="form__hp" aria-hidden="true">
      <label for="feld-website">Website – dieses Feld bitte leer lassen</label>
      <input type="text" id="feld-website" name="website" value="" tabindex="-1" autocomplete="off">
    </div>

    <fieldset class="form__group{{ errors.slot is defined ? ' field--error' : '' }}" aria-describedby="slot-hinweis{{ errors.slot is defined ? ' feld-slot-fehler' : '' }}">
      <legend>Wunschtermin</legend>
      <p class="field__hint" id="slot-hinweis">Wählt einen freien Termin aus. Passt keiner, schlagt ein eigenes Datum vor.</p>
      {% if errors.slot is defined %}<p class="field__error" id="feld-slot-fehler">{{ icon('alert') }}<span><span class="visually-hidden">Fehler: </span>{{ errors.slot }}</span></p>{% endif %}
      <div class="choices">
        {% for slug, label in slots %}
        <div class="choice">
          <input type="radio" id="feld-slot-{{ slug }}" name="slot" value="{{ slug }}"{% if selected == slug %} checked{% endif %}>
          <label for="feld-slot-{{ slug }}">{{ icon('free') }}<span>{{ label }}</span></label>
        </div>
        {% endfor %}
        <div class="choice">
          <input type="radio" id="feld-slot-anderer" name="slot" value="anderer"{% if selected == 'anderer' or (slots is empty and selected == '') %} checked{% endif %}>
          <label for="feld-slot-anderer">{{ icon('calendar') }}<span>Anderes Datum vorschlagen</span></label>
        </div>
      </div>
      {% if slots is empty %}
      <p class="muted">Gerade sind keine Termine ausgeschrieben – schlagt einfach ein Datum vor.</p>
      {% endif %}
      <div class="form__row">
        {% include 'partials/form-field.html.twig' with base|merge({name: 'wishdate', label: labels.wishdate, type: 'date', hint: 'Nur bei „Anderes Datum vorschlagen“.', min: form.tomorrow}) only %}
        {% include 'partials/form-field.html.twig' with base|merge({name: 'altdate', label: labels.altdate, type: 'date', hint: 'Falls der Wunschtermin nicht klappt.', min: form.tomorrow}) only %}
      </div>
    </fieldset>

    <fieldset class="form__group">
      <legend>Eure Gruppe</legend>
      {% include 'partials/form-field.html.twig' with base|merge({name: 'groupname', label: labels.groupname, required: true, autocomplete: 'organization', maxlength: 120}) only %}
      {% include 'partials/form-field.html.twig' with base|merge({name: 'grouptype', label: labels.grouptype, type: 'select', required: true, options: group_types}) only %}
      {% include 'partials/form-field.html.twig' with base|merge({name: 'intro', label: labels.intro, type: 'textarea', required: true, rows: 4, hint: 'Wer seid ihr und was macht ihr? Ein, zwei Sätze reichen.', maxlength: 1500}) only %}
    </fieldset>

    <fieldset class="form__group">
      <legend>Ansprechperson</legend>
      {% include 'partials/form-field.html.twig' with base|merge({name: 'contactname', label: labels.contactname, required: true, autocomplete: 'name', maxlength: 100}) only %}
      {% include 'partials/form-field.html.twig' with base|merge({name: 'email', label: labels.email, type: 'email', required: true, autocomplete: 'email', hint: 'Hierhin schicken wir unsere Antwort.', maxlength: 254}) only %}
      {% include 'partials/form-field.html.twig' with base|merge({name: 'phone', label: labels.phone, type: 'tel', autocomplete: 'tel', inputmode: 'tel', hint: 'Falls wir kurz anrufen dürfen.', maxlength: 40}) only %}
    </fieldset>

    <fieldset class="form__group">
      <legend>Noch etwas?</legend>
      {% include 'partials/form-field.html.twig' with base|merge({name: 'message', label: labels.message, type: 'textarea', rows: 5, hint: 'Ideen für den Abend, Fragen oder besondere Wünsche.', maxlength: 3000}) only %}
    </fieldset>

    <div class="field field--check{{ errors.privacy is defined ? ' field--error' : '' }}">
      {% if errors.privacy is defined %}<p class="field__error" id="feld-privacy-fehler">{{ icon('alert') }}<span><span class="visually-hidden">Fehler: </span>{{ errors.privacy }}</span></p>{% endif %}
      <div class="choice choice--check">
        <input type="checkbox" id="feld-privacy" name="privacy" value="ja" required{% if (values.privacy ?? '') == 'ja' %} checked{% endif %}{% if errors.privacy is defined %} aria-invalid="true" aria-describedby="feld-privacy-fehler"{% endif %}>
        <label for="feld-privacy">Ich habe die <a href="{{ kneipe.url('/datenschutz') }}">Datenschutzerklärung</a> gelesen und bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage gespeichert werden.</label>
      </div>
      {% if page.header.privacynote %}<p class="field__hint">{{ ktext(page.header.privacynote) }} Löschfrist: {{ kneipe.retentionDays }} Tage.</p>{% endif %}
    </div>

    <div class="form__submit">
      <button class="button button--primary button--large" type="submit">Anfrage senden{{ icon('arrow') }}</button>
      <p class="muted small">Die Anfrage ist unverbindlich. Sie wird nicht veröffentlicht.</p>
    </div>
  </form>
</div>
{% endblock %}
