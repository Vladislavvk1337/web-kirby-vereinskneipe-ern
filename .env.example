# ---------------------------------------------------------------------------
# Umgebungsvariablen für Kirby – als .env kopieren und ausfüllen.
# Lokal: Datei .env im Projektverzeichnis.
# Server: /var/www/<DOMAIN>/config/kirby.env (legt deploy/server-setup.sh an,
#         Pfad kommt über KIRBY_ENV_FILE aus dem PHP-FPM-Pool).
# Nie ins Repository committen.
# ---------------------------------------------------------------------------

# Fehlerdetails anzeigen – nur lokal!
KIRBY_DEBUG=false

# Öffentliche Basis-URL ohne Schrägstrich am Ende (Produktion Pflicht)
KIRBY_URL=https://www.example.org

# Zufällige Geheimnisse (je 64 Zeichen), z. B. erzeugen mit:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
KIRBY_CONTENT_SALT=
KIRBY_COOKIE_KEY=

# Suchmaschinen aussperren (Vorschau/Staging)
KIRBY_NOINDEX=false

# Pfade für Laufzeitdaten außerhalb des Programmcodes (Server).
# Leer = Plainkit-Struktur im Projektverzeichnis (lokal).
# KIRBY_CONTENT_ROOT=/var/www/example.org/data/content
# KIRBY_MEDIA_ROOT=/var/www/example.org/data/media
# KIRBY_STORAGE_ROOT=/var/www/example.org/data/storage

# E-Mail-Versand: smtp | mail | none (none = nichts versenden, z. B. lokal)
KIRBY_MAIL_TRANSPORT=smtp
KIRBY_SMTP_HOST=smtp.example.org
KIRBY_SMTP_PORT=587
KIRBY_SMTP_SECURITY=tls
KIRBY_SMTP_USER=noreply@example.org
KIRBY_SMTP_PASSWORD=
# Absender muss zum SMTP-Konto passen (SPF/DMARC)
KIRBY_MAIL_FROM=noreply@example.org
KIRBY_MAIL_FROM_NAME="Ehrenamtskneipe Erndtebrück"

# Missbrauchsschutz für das Anfrageformular
KNEIPE_RATE_LIMIT=5
KNEIPE_MIN_SECONDS=3

# Zeitzone
KIRBY_TIMEZONE=Europe/Berlin
