# ---------------------------------------------------------------------------
# Umgebungsvariablen für docker run --env-file / podman --env-file.
# Kopieren nach .env (nie committen). Kubernetes: ConfigMap + Secret (k8s/).
# Vollständige Liste: Docker.md
# ---------------------------------------------------------------------------

# dev | staging | production
GRAV_ENVIRONMENT=production

# Öffentliche Adresse ohne Schrägstrich am Ende (staging/production Pflicht)
GRAV_CONFIG=true
GRAV_CONFIG__system__custom_base_url=https://www.example.org

# Erstes Administrationskonto (nur beim allerersten Start, wenn /data/accounts leer ist)
KNEIPE_ADMIN_USERNAME=admin
KNEIPE_ADMIN_EMAIL=admin@example.org
KNEIPE_ADMIN_PASSWORD=

# Geheime Schlüssel (je mindestens 32 Zeichen), z. B.:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
GRAV_NONCE_KEY=
GRAV_API_JWT_SECRET=

# E-Mail-Versand (SMTP). Ohne engine=smtp werden keine Mails verschickt.
GRAV_CONFIG__plugins__email__mailer__engine=smtp
GRAV_CONFIG__plugins__email__mailer__smtp__server=smtp.example.org
GRAV_CONFIG__plugins__email__mailer__smtp__port=587
GRAV_CONFIG__plugins__email__mailer__smtp__encryption=tls
GRAV_CONFIG__plugins__email__mailer__smtp__user=noreply@example.org
GRAV_CONFIG__plugins__email__mailer__smtp__password=
GRAV_CONFIG__plugins__email__from=noreply@example.org

# Missbrauchsschutz für das Anfrageformular
KNEIPE_RATE_LIMIT=5
KNEIPE_MIN_SECONDS=3
