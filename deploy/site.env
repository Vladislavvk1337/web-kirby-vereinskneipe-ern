# -----------------------------------------------------------------------------
# HINWEIS: Gilt nur für den alten Linux-Server (Kirby, Branch kirby-legacy),
# solange er bis zur Abschaltung weiterläuft (Docker.md, Kapitel 27). Der
# Kubernetes-Betrieb verwendet diese Datei nicht; deploy/server-setup.sh und
# deploy/caddy/ liegen nur noch in kirby-legacy.
#
# Projektkonfiguration für den Server – EINZIGE Stelle für Namen, Adressen und
# Benutzer. Wird gelesen von:
#
#   deploy/basis-schutz.sh   → basis-schutz-os (Admin-Benutzer, DOMAIN, PHP)
#   deploy/server-setup.sh   → Caddy, PHP-FPM-Pool für Kirby, Timer
#
# Enthält keine Geheimnisse und liegt im Repository. Geheimnisse (SMTP,
# Salt, Cookie-Schlüssel) stehen nur auf dem Server in
# /var/www/$DOMAIN/config/kirby.env. Serverlokale Abweichungen gehören nach
# /etc/site.local.env – beide Skripte lesen sie zuletzt ein.
# -----------------------------------------------------------------------------

# --- Projekt -----------------------------------------------------------------
# Kurzname aus Kleinbuchstaben, Ziffern und Bindestrich. Bestimmt die
# Verzeichnisse /srv/$PROJECT/repo und /srv/$PROJECT/state.
PROJECT="kneipe"

# Branch, der auf dem Server veröffentlicht wird
BRANCH="main"

# --- Adressen ----------------------------------------------------------------
# Hauptdomain ohne www – PLATZHALTER, vor dem ersten Deployment ersetzen.
# Bestimmt die Verzeichnisse /var/www/$DOMAIN/… und den PHP-FPM-Pool.
DOMAIN="example.de"

# Vorschau-Adresse (Phase „preview“, mit noindex) und endgültige Adresse
# (Phase „live“). Die nackte Domain leitet im Livebetrieb auf LIVE_HOST um.
PREVIEW_HOST="labs.example.de"
LIVE_HOST="www.example.de"

# preview = nur PREVIEW_HOST, nicht indexierbar
# live    = LIVE_HOST, DOMAIN leitet um, PREVIEW_HOST leitet auf LIVE_HOST um
# Umstellen: Wert ändern, pushen, dann sudo deploy/server-setup.sh
SITE_PHASE="preview"

# Öffentliche Adresse (KIRBY_URL): Canonical-Links, Sitemap, Mails.
# Leer = automatisch passend zur Phase.
SITE_URL=""

# Kontaktadresse für Let's Encrypt / ZeroSSL (Ablaufwarnungen)
ACME_EMAIL="admin@example.de"

# --- Benutzer ----------------------------------------------------------------
# Admin-Benutzer von basis-schutz-os: SSH-Login, sudo, besitzt den Programmcode
ADMIN_USER="kneipeadm"
# Holt den Stand von GitHub und installiert Abhängigkeiten – ohne Login und sudo
BUILD_USER="kneipebuild"

# --- Datensicherung ----------------------------------------------------------
# Tägliche Sicherung von Inhalten, Konten und Konfiguration (kneipe-backup.timer)
BACKUP_DIR="/var/backups/kneipe"
BACKUP_KEEP_DAYS="14"
