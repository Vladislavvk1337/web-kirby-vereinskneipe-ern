# --------------------------------------------------------------------------
# Phase „live“ (SITE_PHASE="live" in deploy/site.env)
# Erst umstellen, wenn DOMAIN und LIVE_HOST per DNS auf diesen Server zeigen
# (Deployment.md, Abschnitt „Livegang“).
# --------------------------------------------------------------------------
{{LIVE_HOST}} {
	import site live
}

# Nackte Domain auf die Hauptadresse umleiten
{{DOMAIN}} {
	redir https://{{LIVE_HOST}}{uri} permanent
}
