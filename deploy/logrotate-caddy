# Installiert von deploy/server-setup.sh nach /etc/logrotate.d/site-caddy
# Zugriffsprotokolle von Caddy täglich rotieren und nach 14 Tagen löschen
# (Datenschutzerklärung, Abschnitt „Server-Logfiles"). Caddy rotiert selbst
# nicht (roll_disabled), copytruncate lässt die Datei für Caddy offen.
/var/log/caddy/*.log {
	daily
	rotate 14
	maxage 14
	missingok
	notifempty
	copytruncate
	compress
	delaycompress
	su caddy caddy
}
