# -----------------------------------------------------------------------------
# HINWEIS: Gilt nur für den alten Linux-Server (Kirby, Branch kirby-legacy),
# solange er bis zur Abschaltung weiterläuft (Docker.md, Kapitel 27). Der
# Kubernetes-Betrieb verwendet diese Datei nicht; deploy/server-setup.sh und
# deploy/caddy/ liegen nur noch in kirby-legacy.
#
# basis-schutz-os – Einstellungen für diesen Server
#
# deploy/basis-schutz.sh setzt daraus config.env zusammen, in dieser
# Reihenfolge:
#
#   1. deploy/site.env          Projekt, Domain, Admin-Benutzer
#   2. deploy/basis-schutz.env  diese Datei – darf Werte aus 1. verwenden
#   3. /etc/site.local.env      nur auf dem Server, z. B. FAIL2BAN_IGNOREIP
#
# Enthält keine Geheimnisse. Webserver ist Caddy (deploy/caddy/) – das Modul
# "nginx" wird NICHT ausgeführt, TLS und CSP übernimmt Caddy.
# -----------------------------------------------------------------------------

# --- Admin-Benutzer ----------------------------------------------------------
ADMIN_PASSWORD_HASH=""          # leer = interaktive Abfrage beim ersten Lauf
SUDO_NOPASSWD="false"
COPY_ROOT_KEYPAIRS="true"
LOCK_ROOT_PASSWORD="true"
CLEAR_ROOT_AUTHORIZED_KEYS="false"

# --- System ------------------------------------------------------------------
TIMEZONE="Europe/Berlin"
SSH_PORT="22"
AUTO_REBOOT="false"
AUTO_REBOOT_TIME="04:00"
FAIL2BAN_IGNOREIP=""

# --- Webseite ----------------------------------------------------------------
DOMAIN_ALIASES="$LIVE_HOST $PREVIEW_HOST"

# TLS und CSP setzt Caddy (deploy/caddy/Caddyfile)
ENABLE_TLS="false"
LETSENCRYPT_EMAIL="$ACME_EMAIL"
CSP=""

# --- PHP ---------------------------------------------------------------------
# Das Modul php installiert und härtet PHP-FPM (php.ini, gesperrte
# Funktionen). Kirby läuft in einem eigenen Pool aus deploy/php/, den
# deploy/server-setup.sh anlegt. PHPMailer bringt Kirby selbst mit.
ENABLE_PHP="true"
PHP_COMPOSER_PACKAGES=""
