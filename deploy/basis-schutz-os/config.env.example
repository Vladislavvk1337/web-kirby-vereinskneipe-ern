# -----------------------------------------------------------------------------
# basis-schutz-os – Konfiguration
#
# Kopieren nach config.env und anpassen:
#   cp config.env.example config.env
# config.env ist per .gitignore vom Repository ausgeschlossen.
# -----------------------------------------------------------------------------

# --- Admin-Benutzer ----------------------------------------------------------
# Dieser Benutzer ersetzt den Root-Login. Er bekommt sudo-Rechte und die
# SSH-Keys von root (authorized_keys + Schlüsselpaare aus /root/.ssh/id_*).
ADMIN_USER="keiladm"

# Passwort für sudo als SHA-512-Hash (NICHT im Klartext!). Erzeugen mit:
#   openssl passwd -6
# Leer lassen = das Skript fragt interaktiv nach einem Passwort
# (oder bricht ab, wenn es nicht interaktiv läuft und SUDO_NOPASSWD="false").
ADMIN_PASSWORD_HASH=""

# "true" = sudo ohne Passwort (bequemer, aber weniger sicher).
SUDO_NOPASSWD="false"

# Privaten + öffentlichen Schlüssel aus /root/.ssh/id_* zum Admin kopieren.
COPY_ROOT_KEYPAIRS="true"

# Root-Passwort sperren (Login nur noch über sudo). Empfohlen.
LOCK_ROOT_PASSWORD="true"

# /root/.ssh/authorized_keys nach erfolgreichem Kopieren leeren.
# Root-Login per SSH ist ohnehin deaktiviert – das ist eine zusätzliche Stufe.
CLEAR_ROOT_AUTHORIZED_KEYS="false"

# --- System ------------------------------------------------------------------
TIMEZONE="Europe/Berlin"
SSH_PORT="22"

# Automatischer Neustart nach Kernel-Updates (unattended-upgrades)
AUTO_REBOOT="false"
AUTO_REBOOT_TIME="04:00"

# IPs/Netze, die fail2ban nie sperrt (z. B. Büro-IP), durch Leerzeichen getrennt
FAIL2BAN_IGNOREIP=""

# --- Webseite ----------------------------------------------------------------
# Hauptdomain (ohne https://). Pflicht für die Module php, nginx.
DOMAIN=""
# Zusätzliche Namen, durch Leerzeichen getrennt, z. B. "www.example.de"
DOMAIN_ALIASES=""

# Let's-Encrypt-Zertifikat holen (DNS muss bereits auf den Server zeigen!)
ENABLE_TLS="true"
LETSENCRYPT_EMAIL=""

# Content-Security-Policy. Astro erzeugt u. U. Inline-Skripte für Islands,
# deshalb ist 'unsafe-inline' für script-src standardmäßig erlaubt.
# Externe Dienste (Fonts, Analytics, …) hier ergänzen. Leer = kein CSP-Header.
CSP="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

# --- PHP (E-Mail-Versand) ----------------------------------------------------
ENABLE_PHP="true"

# Composer-Pakete für den Mailversand, durch Leerzeichen getrennt.
# Beispiele: "phpmailer/phpmailer"  oder  "symfony/mailer"
# Das mitgelieferte Beispiel (examples/php/contact.php) nutzt PHPMailer.
PHP_COMPOSER_PACKAGES="phpmailer/phpmailer"

# Rate-Limit für /api/*.php pro IP (nginx limit_req), z. B. "5r/m"
API_RATE="5r/m"
API_BURST="5"
